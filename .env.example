APP_NAME=sharecart-ai-service
APP_ENV=prod
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

APP_JWT_SECRET=replace_with_shared_spring_boot_secret
APP_JWT_ALGORITHM=HS512

OPENAI_API_KEY=replace_with_openai_api_key
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_SECONDS=25

MAX_UPLOAD_BYTES=10485760
MAX_IMAGE_DIMENSION=2200

RATE_LIMIT_HOURLY=10
RATE_LIMIT_DAILY=50

CORS_ORIGINS=*
